   "robot_reask_mean_s": 30.0,
   "n_devices": 16,
   "run_s": 1200.0,
   "seed": 4,
   "planner_wall_clock_cutoff": "patched off"
  },
  "script": "experiments/orchestration/live2/kv025_runnability_probe.py",
  "script_note": "the committed file is BYTE-IDENTICAL (sha256 026c6ef5088373abef10b3d9e639950fcf7f9a1cefc02f3677ab7f6dcc886630) to the file that was executed, which sat at experiments/orchestration/live2/kv025_probe.py inside the clean export; it must be run FROM the live2 directory, since it needs its own directory on sys.path",
  "what_a_dry_cell_CANNOT_show_here": "the COST of an eviction. A dry cell has no engine, so a history that enforcement pushed to host is never re-prefilled against a real prefill curve. Every cost statement in this file is therefore taken from COMMITTED LIVE cells, never from the replay, and the replay is used only for (a) does it raise, (b) does it spin, (c) does the pool move a decision, (d) does enforcement reach the eviction branch."
 },
