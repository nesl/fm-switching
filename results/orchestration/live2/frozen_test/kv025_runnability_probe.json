  "tokens_1x": 62944,
  "tokens_0.5x": 31472,
  "tokens_0.25x": 15736,
  "driver_line": "experiments/orchestration/study_frozen_grid_driver_v28.sh:85  case \"$tag\" in *_kv0.5*) lflag=\"$lflag --gpu-kv-tokens 31472\";; *_kv0.25*) lflag=\"$lflag --gpu-kv-tokens 15736\";; esac",
  "default_source": "experiments/orchestration/live2/run_live2_real.py:130 (--gpu-kv-tokens default 62944) and experiments/orchestration/live2/tests/test_live2_coord.py:40 (GPU_KV = 62_944); 15,736 = 62,944 / 4 exactly",
  "enforcement": "every frozen-grid cell runs --kv-capacity-enforced (study_frozen_grid_driver_v28.sh:130)",
  "caveat": "_kv0.25 changes the HARNESS'S LOGICAL pool only, the coordinator's belief plus enforcement at --gpu-kv-tokens 15736. THE ENGINE'S REAL vLLM ALLOCATION IS PINNED AND UNCHANGED, exactly as the driver's own D151 comment says for _kv0.5."
 },
 "_protocol": {
  "clean_checkout": "git archive origin/main at b20cb15f9b44ae2af2a97f5053734f372bccac58, extracted to a scratch tree; NOT the shared worktree. arms_v6cf is deliberately NOT registered, because arms.py reverted its registration on origin/main (cf_protect_defer calls cf_objective.attainment_margin at import time and that function is in no commit); importing it would have killed this probe on a clean checkout for every arm.",
  "one_cell_per_process": true,
  "concurrency": "3 concurrent dry cells throughout, declared because host load can perturb a dry digest (d184_r3_wallclock_probe.json)",
  "digest_recipe": "sha256(json.dumps(rows without arm_version, sort_keys=True, separators=(',',':'), default=float))[:16], the committed recipe",
