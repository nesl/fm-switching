    "metric": "correct_answers_delivered_by_deadline",
    "definition": "D155 (3): the cloud's answer when it is delivered within the deadline, otherwise the DEVICE's answer IF THE DEVICE'S ANSWER ALSO ARRIVES WITHIN THE DEADLINE, otherwise no answer and the question is a miss; each answer scored on the representation actually sent",
    "correct_answers_delivered_by_deadline": 0.058824,
    "n_by_deadline": 68,
    "beside_it_any_time": {
     "metric": "correct_answers_delivered_any_time",
     "definition": "D152 (1), reported beside the headline and never mixed with it: the cloud's answer when it is delivered within the deadline, otherwise the device's answer REGARDLESS OF WHEN IT LANDS",
     "correct_answers_delivered_any_time": 0.058824,
     "n": 68
    },
    "device_side": {
     "rule": {
      "device_latency_source": "orin_rec_warm",
      "device_wait_s": 0.0,
      "superseded_source": false,
      "meaning": "orin_rec_warm: StudyORIN-REC's MEASURED WARM per-question device COMPLETION latency on the 97 LH-REQ questions (Jetson AGX Orin, qwen3vl4b under vLLM, commit 00a223d). WARM PATH: the exact RECENT frames are prefilled first and cached_tokens covers them on all 97, so it is not comparable to a cold prefill curve.",
      "excluded": "D155 (1): the LH-REQ device answer latencies, end-to-end median 3.354 s of which 3.296 s is TTFT (D155a corrects the earlier 6.651 s, which had added TTFT to an end-to-end figure that already contained it), are the COLD RE-SEND path, which D61 (b) classifies as an API artifact and not the device baseline. Not used here.",
      "answer_length": "D146 (1) / P20: a robot answer is 2 OUTPUT TOKENS (completion_tokens == 2 on all 97 measured questions), so the 512-token answer cap is not the device's latency lever and a 0.270 s completion is almost entirely prefill plus fixed overhead.",
      "cascade_device_wait": {
       "arms": [
        "confidence-cascade",
        "cascade-routing",
        "r3-streaming",
        "streamscout"
       ],
       "live_charge_s": 0.567,
       "live_charge_site": "baselines/costs.py:37 -> coordinator.py:63, applied at :471 and :505",
       "measured_warm_s": 0.2697,
       "measured_warm_source": "StudyORIN-REC warm p50 (commit 00a223d), per question where keyed",
       "measured_device_wait_applied": false,
       "label": "proxy-0.567",
       "register": "the live cascade wait is a RERUN item, not a re-score: it changes when the arm may act. Until coordinator.py adopts the measured value every cascade cell is labelled proxy-0.567 per D154 (5), whatever the scorer's device latency source is. The scorer's own device-answer arrival IS on the measured table.",
       "superseded": "data_sources.DEVICE_WAIT_RULE_S = 0.567 is kept and labelled superseded; it is write-only (one reference, its own declaration) and is not what these arms pay"
      },
      "source": "D155 (3) amending D152 (1), user decision 2026-11-20"
     },
     "device_latency_s_range": [
      0.256,
      0.3065
     ],
     "device_answers_late": 0,
