__pycache__/
*.pyc
.venv/

# regenerable artifacts (reproduced by the generator/sim/plot scripts)
# results/*.json
# plots/*.png
# plots/sprint_2/
# plots/sprint_2/*.png
# plots/sprint_2/multi_seed/*.png
simulator/*.pt
# simulator/trained_*.log.json

# regenerable simulator outputs & generated traces
simulator/results/
simulator/traces/

# regenerable multi-seed data outputs (curated SUMMARY.md is kept)
results/sprint_2/*.csv
results/sprint_2/*.txt

# Raw datasets (large video/image files — download separately)
# Use data/* (not data/) so negations below can un-ignore specific subdirs
data/*
!data/audit_subsets/
data/audit_subsets/*
!data/audit_subsets/phase0a/
data/audit_subsets/phase0a/*
!data/audit_subsets/phase0a/*.json

# Intermediate run checkpoints (overwritten by reruns; final result JSON is canonical)
results/*_ckpt.json

# Run logs
logs/

# HuggingFace token
hf-token.txt

# Claude Code local settings and memory
.claude/
MEMORY.md
*_memory*.md
*_recovery*.md
*_backup*.md
